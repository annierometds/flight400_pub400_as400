/* FLBUILD - builds Flight400 in one PUB400 library                  */
/* CALL FLBUILD PARM('MYLIB' 'COMPILE')  then  PARM('MYLIB' 'DATA')    */
/* Results are written to table MYLIB/FLBLOG                           */
             PGM        PARM(&LIB &MODE)
             DCL        VAR(&LIB) TYPE(*CHAR) LEN(10)
             DCL        VAR(&MODE) TYPE(*CHAR) LEN(7)
             DCL        VAR(&STEP) TYPE(*CHAR) LEN(60)
             DCL        VAR(&FAIL) TYPE(*CHAR) LEN(1)
             DCL        VAR(&NOK) TYPE(*DEC) LEN(5 0)
             DCL        VAR(&NBAD) TYPE(*DEC) LEN(5 0)
             DCL        VAR(&NOKC) TYPE(*CHAR) LEN(5)
             DCL        VAR(&NBADC) TYPE(*CHAR) LEN(5)
             DCL        VAR(&SQL) TYPE(*CHAR) LEN(300)

             ADDLIBLE   LIB(&LIB) POSITION(*FIRST)
             MONMSG     MSGID(CPF2103)
             CHGVAR     VAR(&SQL) VALUE('CREATE TABLE ' *TCAT &LIB +
                          *TCAT '/FLBLOG (LINE VARCHAR(100))')
             RUNSQL     SQL(&SQL) COMMIT(*NONE) NAMING(*SYS)
             MONMSG     MSGID(SQL0000 CPF0000)
             CHGVAR     VAR(&SQL) VALUE('DELETE FROM ' *TCAT &LIB +
                          *TCAT '/FLBLOG')
             RUNSQL     SQL(&SQL) COMMIT(*NONE) NAMING(*SYS)
             MONMSG     MSGID(SQL0000 CPF0000)

             IF         COND(&MODE *EQ 'DATA') THEN(GOTO CMDLBL(DATA))
             CHGVAR     VAR(&STEP) VALUE('CRTMSGF FRSMSGF')
             CHGVAR     VAR(&FAIL) VALUE('0')
             DLTMSGF    MSGF(&LIB/FRSMSGF)
             MONMSG     MSGID(CPF0000)
             CHGVAR     VAR(&STEP) VALUE('CRTMSGF FRSMSGF')
             CHGVAR     VAR(&FAIL) VALUE('0')
             CRTMSGF    MSGF(&LIB/FRSMSGF) TEXT('Flight400 messages')
             MONMSG     MSGID(CPF0000 CPD0000 QRG0000 RNS0000 SQL0000 +
                          MCH0000 CEE0000) +
                          EXEC(CHGVAR VAR(&FAIL) VALUE('1'))
             CALLSUBR   SUBR(LOG)
             CHGVAR     VAR(&STEP) VALUE('ADDMSGD FRS0021')
             CHGVAR     VAR(&FAIL) VALUE('0')
             ADDMSGD    MSGID(FRS0021) MSGF(&LIB/FRSMSGF) +
                          MSG('The FLIGHT NUMBER entry is missing')
             MONMSG     MSGID(CPF0000 CPD0000 QRG0000 RNS0000 SQL0000 +
                          MCH0000 CEE0000) +
                          EXEC(CHGVAR VAR(&FAIL) VALUE('1'))
             CALLSUBR   SUBR(LOG)
             CHGVAR     VAR(&STEP) VALUE('ADDMSGD FRS0022')
             CHGVAR     VAR(&FAIL) VALUE('0')
             ADDMSGD    MSGID(FRS0022) MSGF(&LIB/FRSMSGF) +
                          MSG('The entry for the DAY OF THE WEEK is mis+
                          sing')
             MONMSG     MSGID(CPF0000 CPD0000 QRG0000 RNS0000 SQL0000 +
                          MCH0000 CEE0000) +
                          EXEC(CHGVAR VAR(&FAIL) VALUE('1'))
             CALLSUBR   SUBR(LOG)
             CHGVAR     VAR(&STEP) VALUE('ADDMSGD FRS0023')
             CHGVAR     VAR(&FAIL) VALUE('0')
             ADDMSGD    MSGID(FRS0023) MSGF(&LIB/FRSMSGF) +
                          MSG('The entry for the DAY OF THE WEEK is inv+
                          alid')
             MONMSG     MSGID(CPF0000 CPD0000 QRG0000 RNS0000 SQL0000 +
                          MCH0000 CEE0000) +
                          EXEC(CHGVAR VAR(&FAIL) VALUE('1'))
             CALLSUBR   SUBR(LOG)
             CHGVAR     VAR(&STEP) VALUE('ADDMSGD FRS0024')
             CHGVAR     VAR(&FAIL) VALUE('0')
             ADDMSGD    MSGID(FRS0024) MSGF(&LIB/FRSMSGF) +
                          MSG('The entry for DEPARTURE/ARRIVAL TIME is m+
                          issing or invalid')
             MONMSG     MSGID(CPF0000 CPD0000 QRG0000 RNS0000 SQL0000 +
                          MCH0000 CEE0000) +
                          EXEC(CHGVAR VAR(&FAIL) VALUE('1'))
             CALLSUBR   SUBR(LOG)
             CHGVAR     VAR(&STEP) VALUE('ADDMSGD FRS0025')
             CHGVAR     VAR(&FAIL) VALUE('0')
             ADDMSGD    MSGID(FRS0025) MSGF(&LIB/FRSMSGF) +
                          MSG('The entry for MILEAGE is missing')
             MONMSG     MSGID(CPF0000 CPD0000 QRG0000 RNS0000 SQL0000 +
