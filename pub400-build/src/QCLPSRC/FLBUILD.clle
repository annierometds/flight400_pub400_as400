 DONE:
             CHGVAR     VAR(&NOKC) VALUE(&NOK)
             CHGVAR     VAR(&NBADC) VALUE(&NBAD)
             CHGVAR     VAR(&STEP) VALUE('SUMMARY ' *CAT &MODE *BCAT +
                          'ok=' *CAT &NOKC *BCAT 'failed=' *CAT &NBADC)
             CHGVAR     VAR(&FAIL) VALUE('0')
             CALLSUBR   SUBR(LOG)
             SNDPGMMSG  MSG(&STEP) MSGTYPE(*COMP)
             RETURN

             SUBR       SUBR(LOG)
             IF         COND(&FAIL *EQ '1') THEN(DO)
               CHGVAR     VAR(&NBAD) VALUE(&NBAD + 1)
               CHGVAR     VAR(&STEP) VALUE('FAILED  ' *CAT &STEP)
             ENDDO
             ELSE       CMD(DO)
               IF         COND(%SST(&STEP 1 7) *NE 'SUMMARY') +
                            THEN(CHGVAR VAR(&NOK) VALUE(&NOK + 1))
               CHGVAR     VAR(&STEP) VALUE('ok      ' *CAT &STEP)
             ENDDO
             CHGVAR     VAR(&SQL) VALUE('INSERT INTO ' *TCAT &LIB +
                          *TCAT '/FLBLOG VALUES(''' *CAT %TRIM(&STEP) +
                          *TCAT ''')')
             RUNSQL     SQL(&SQL) COMMIT(*NONE) NAMING(*SYS)
             MONMSG     MSGID(SQL0000 CPF0000)
             ENDSUBR
             ENDPGM
