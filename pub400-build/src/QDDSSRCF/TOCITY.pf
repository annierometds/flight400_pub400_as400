                                            UNIQUE
                R TOCTYR
                  TOCNAM        16A         TEXT('TO CITY NAME')
                                            COLHDG('TO CITY NAME')
                  TOCINT         3A         TEXT('TO CITY INITIALS')
                                            COLHDG('   TO' '  CITY' 'INITIALS')
                  TOCACT        20A         TEXT('AIRCRAFT TYPE')
                                            COLHDG('AIRCRAFT' '  TYPE')
                K TOCNAM
