**FREE

//=====================================================================
// Program: FRS024 - Customer Name Maintenance
// Description: Interactive program to maintain customer names
// Modernized: 2025-01-20
// - Converted from OPM RPG to fully free-format ILE RPGLE
// - Replaced indicators with boolean variables
// - Converted subroutines to procedures
// - Removed GOTO statements with structured logic
// - Replaced I-specs with named constants
// - Replaced O-specs/EXCEPT with SQL operations
// - Added comprehensive error handling
//=====================================================================

CTL-OPT DFTACTGRP(*NO) ACTGRP(*NEW) OPTION(*NODEBUGIO:*SRCSTMT);

// Display file
DCL-F FRS024DF WORKSTN INFDS(workstationDS);

//---------------------------------------------------------------------
// Named Constants - Function Keys
//---------------------------------------------------------------------
DCL-C F01 X'31';
DCL-C F02 X'32';
DCL-C F03 X'33';
DCL-C F04 X'34';
DCL-C F09 X'39';
DCL-C F10 X'3A';
DCL-C F11 X'3B';
DCL-C F12 X'3C';
DCL-C ENTER X'F1';
DCL-C HELP X'F3';
DCL-C PRINT X'F6';

//---------------------------------------------------------------------
// Named Constants - Other
//---------------------------------------------------------------------
DCL-C APOST X'7D';
DCL-C CHARS 'ABCDEFGHIJKLMNOPQRSTUVWXYZ-
             abcdefghijklmnopqrstuvwxyz ';

//---------------------------------------------------------------------
// Program Status Data Structure
//---------------------------------------------------------------------
DCL-DS programSDS PSDS QUALIFIED;
  programName *PROC;
  status *STATUS;
  numberOfParms *PARMS;
  messageId CHAR(7) POS(40);
  exceptionData CHAR(79) POS(91);
  jobName CHAR(10) POS(244);
  userName CHAR(10) POS(254);
  jobNumber CHAR(6) POS(264);
  sourceFile CHAR(10) POS(304);
  sourceLibrary CHAR(10) POS(314);
  sourceMember CHAR(10) POS(324);
END-DS;

//---------------------------------------------------------------------
// Workstation Data Structure
//---------------------------------------------------------------------
DCL-DS workstationDS QUALIFIED;
  functionKey CHAR(1) POS(369);
END-DS;

//---------------------------------------------------------------------
// API Error Data Structure
//---------------------------------------------------------------------
DCL-DS apiError QUALIFIED;
  bytesProvided INT(10) INZ(256);
  bytesAvailable INT(10) INZ(0);
  exceptionId CHAR(7) INZ;
  reserved CHAR(1) INZ;
  exceptionData CHAR(240) INZ;
END-DS;

//---------------------------------------------------------------------
// Message Data Structure
//---------------------------------------------------------------------
DCL-DS messageDS QUALIFIED;
  callStackCounter INT(10) INZ(0);
  messageLength INT(10) INZ(80);
  messageFile CHAR(20) INZ('FRSMSGF   *LIBL     ');
  messageType CHAR(10) INZ('*INFO     ');
  messageKey CHAR(4) INZ('    ');
END-DS;

//---------------------------------------------------------------------
// Remove Message Data Structure
//---------------------------------------------------------------------
DCL-DS removeMsgDS QUALIFIED;
  callStackCounter INT(10) INZ(0);
  messageQueue CHAR(10) INZ('*         ');
  clearOption CHAR(10) INZ('*ALL      ');
  messageKey CHAR(4) INZ('    ');
END-DS;

//---------------------------------------------------------------------
// Customer Data Structure
//---------------------------------------------------------------------
DCL-DS customerKey QUALIFIED;
  length INT(5);
  name CHAR(64);
END-DS;

//---------------------------------------------------------------------
// Global Variables - Boolean flags
//---------------------------------------------------------------------
DCL-S exitProgram IND INZ(*OFF);
DCL-S errorOccurred IND INZ(*OFF);
DCL-S showError IND INZ(*OFF);
DCL-S highlightField IND INZ(*OFF);

//---------------------------------------------------------------------
// Global Variables - Work fields
//---------------------------------------------------------------------
DCL-S messageId CHAR(7);
DCL-S messageData CHAR(80);
DCL-S messageQueue CHAR(10);
DCL-S nameCheck CHAR(25);
DCL-S characterCount INT(10);

//---------------------------------------------------------------------
// SQL Host Variables
// Note: SQLCA is automatically generated by SQL precompiler
//---------------------------------------------------------------------
DCL-S sql_custId PACKED(9:0);
DCL-S sql_custName CHAR(66);
DCL-S sql_exists IND;

//---------------------------------------------------------------------
// External Program Prototypes
//---------------------------------------------------------------------

// FRS405 - Customer Selection Program
DCL-PR FRS405 EXTPGM('FRS405');
  custNumber PACKED(9:0);
  custName CHAR(25);
END-PR;

// QUSCMDLN - Display Command Line API
DCL-PR QUSCMDLN EXTPGM('QUSCMDLN');
END-PR;

// QMHRMVPM - Remove Program Messages API
DCL-PR QMHRMVPM EXTPGM('QMHRMVPM');
  msgQueue CHAR(10);
  callStackCounter INT(10);
  msgKey CHAR(4);
  clearOption CHAR(10);
  errorCode LIKEDS(apiError);
END-PR;

// QMHSNDPM - Send Program Message API
DCL-PR QMHSNDPM EXTPGM('QMHSNDPM');
  msgId CHAR(7);
  msgFile CHAR(20);
  msgData CHAR(80);
  msgLen INT(10);
  msgType CHAR(10);
  msgQueue CHAR(10);
  callStackCounter INT(10);
  msgKey CHAR(4);
  errorCode LIKEDS(apiError);
END-PR;

//=====================================================================
// Main Program Logic
//=====================================================================

initialize();

DOW NOT exitProgram;
  // Write message control area
  WRITE MSGCTL;

  // Display screen and wait for input
  EXFMT SELCTR;

  // Process function keys
  SELECT;
    WHEN workstationDS.functionKey = F02;
      refreshScreen();
    WHEN workstationDS.functionKey = F03;
      exitProgram = *ON;
    WHEN workstationDS.functionKey = F04;
      selectCustomer();
    WHEN workstationDS.functionKey = F09;
      displayCommandLine();
    WHEN workstationDS.functionKey = F10 AND NOT errorOccurred;
      addOrUpdateCustomer();
    WHEN workstationDS.functionKey = F11 AND NOT errorOccurred;
      deleteCustomer();
    WHEN workstationDS.functionKey = F12;
      exitProgram = *ON;
    OTHER;
      validateInput();
  ENDSL;
ENDDO;

*INLR = *ON;
RETURN;

//=====================================================================
// Procedures
//=====================================================================

//---------------------------------------------------------------------
// initialize - Initialize program variables and screen
//---------------------------------------------------------------------
DCL-PROC initialize;
  // Clear error indicators
  *IN44 = *OFF;
  *IN50 = *OFF;
  *IN51 = *OFF;
  *IN52 = *OFF;

  // Initialize message fields
  messageId = *BLANKS;
  messageData = *BLANKS;
  messageQueue = programSDS.programName;
  PGMQ = programSDS.programName;

  exitProgram = *OFF;
END-PROC;

//---------------------------------------------------------------------
// refreshScreen - Refresh the screen display
//---------------------------------------------------------------------
DCL-PROC refreshScreen;
  // Clear error indicators
  *IN44 = *OFF;
  *IN50 = *OFF;
  *IN51 = *OFF;
  *IN52 = *OFF;

  // Reset the screen record format
  RESET SELCTR;

  // Remove program messages
  removeMessages();
END-PROC;

//---------------------------------------------------------------------
// validateInput - Validate screen input
//---------------------------------------------------------------------
DCL-PROC validateInput;
  DCL-S customerExists IND;

  // Clear error indicators
  *IN44 = *OFF;
  *IN50 = *OFF;
  *IN51 = *OFF;
  *IN52 = *OFF;
  errorOccurred = *OFF;

  // Remove previous messages
  removeMessages();

  // Validate customer number is not zero
  IF SCUST# = 0;
    *IN50 = *ON;
    *IN51 = *ON;
    errorOccurred = *ON;
    messageId = 'FRS0064';
    sendMessage();
    RETURN;
  ENDIF;

  // Check if customer exists in CUSTOMRZ
  customerExists = checkCustomerExists(SCUST#);

  // If customer exists, compare names
  IF customerExists;
    EXEC SQL
      SELECT CUSTNM INTO :sql_custName
      FROM CUSTOMRZ
      WHERE CUSTNO = :SCUST#;

    customerKey.name = *BLANKS;
    customerKey.name = %TRIMR(sql_custName);
    nameCheck = %TRIMR(customerKey.name);

    // If names match, no error
    IF SCUSTN = nameCheck;
      RETURN;
    ENDIF;
  ENDIF;

  // Validate customer name in CUSTNAME
  customerKey.name = *BLANKS;
  customerKey.length = %LEN(%TRIM(SCUSTN));
  customerKey.name = %TRIMR(SCUSTN);

  EXEC SQL
    SELECT COUNT(*) INTO :characterCount
    FROM CUSTNAME
    WHERE CUSTNM = :customerKey.name;

  IF SQLCODE <> 0 OR characterCount = 0;
    *IN50 = *ON;
    *IN52 = *ON;
    errorOccurred = *ON;
    messageId = 'FRS0067';
    sendMessage();
    RETURN;
  ENDIF;

  // Validate characters in customer name
  characterCount = 0;
  characterCount = %CHECK(CHARS : SCUSTN);

  IF characterCount = 0;
    *IN50 = *ON;
    *IN52 = *ON;
    errorOccurred = *ON;
    messageId = 'FRS0066';
    sendMessage();
    RETURN;
  ENDIF;
END-PROC;

//---------------------------------------------------------------------
// checkCustomerExists - Check if customer exists in database
//---------------------------------------------------------------------
DCL-PROC checkCustomerExists;
  DCL-PI *N IND;
    custId PACKED(9:0) CONST;
  END-PI;

  DCL-S rowCount INT(10);

  EXEC SQL
    SELECT COUNT(*) INTO :rowCount
    FROM CUSTOMRZ
    WHERE CUSTNO = :custId;

  IF SQLCODE = 0 AND rowCount > 0;
    RETURN *ON;
  ELSE;
    RETURN *OFF;
  ENDIF;
END-PROC;

//---------------------------------------------------------------------
// addOrUpdateCustomer - Add or update customer record
//---------------------------------------------------------------------
DCL-PROC addOrUpdateCustomer;
  DCL-S customerExists IND;

  customerExists = checkCustomerExists(SCUST#);

  IF customerExists;
    // Update existing customer
    updateCustomer();
  ELSE;
    // Add new customer
    addCustomer();
  ENDIF;

  // Refresh screen after update
  refreshScreen();
END-PROC;

//---------------------------------------------------------------------
// addCustomer - Add new customer to database
//---------------------------------------------------------------------
DCL-PROC addCustomer;
  // Prepare customer data
  sql_custId = SCUST#;
  customerKey.name = *BLANKS;
  customerKey.length = %LEN(%TRIM(SCUSTN));
  customerKey.name = %TRIMR(SCUSTN);
  sql_custName = customerKey.name;

  // Insert new customer record
  EXEC SQL
    INSERT INTO CUSTOMRZ (CUSTNO, CUSTNM)
    VALUES (:sql_custId, :sql_custName);

  IF SQLCODE <> 0;
    // Handle error
    messageId = 'SQL' + %CHAR(SQLCODE);
    messageData = 'Error adding customer';
    sendMessage();
  ENDIF;
END-PROC;

//---------------------------------------------------------------------
// updateCustomer - Update existing customer in database
//---------------------------------------------------------------------
DCL-PROC updateCustomer;
  // Prepare customer data
  sql_custId = SCUST#;
  customerKey.name = *BLANKS;
  customerKey.length = %LEN(%TRIM(SCUSTN));
  customerKey.name = %TRIMR(SCUSTN);
  sql_custName = customerKey.name;

  // Update customer record
  EXEC SQL
    UPDATE CUSTOMRZ
    SET CUSTNM = :sql_custName
    WHERE CUSTNO = :sql_custId;

  IF SQLCODE <> 0;
    // Handle error
    messageId = 'SQL' + %CHAR(SQLCODE);
    messageData = 'Error updating customer';
    sendMessage();
  ENDIF;
END-PROC;

//---------------------------------------------------------------------
// deleteCustomer - Delete customer from database
//---------------------------------------------------------------------
DCL-PROC deleteCustomer;
  DCL-S customerExists IND;

  customerExists = checkCustomerExists(SCUST#);

  IF customerExists;
    sql_custId = SCUST#;

    EXEC SQL
      DELETE FROM CUSTOMRZ
      WHERE CUSTNO = :sql_custId;

    IF SQLCODE <> 0;
      // Handle error
      messageId = 'SQL' + %CHAR(SQLCODE);
      messageData = 'Error deleting customer';
      sendMessage();
    ENDIF;
  ENDIF;

  // Refresh screen after delete
  refreshScreen();
END-PROC;

//---------------------------------------------------------------------
// selectCustomer - Call customer selection program
//---------------------------------------------------------------------
DCL-PROC selectCustomer;
  DCL-S custNumber PACKED(9:0) INZ(0);
  DCL-S custName LIKE(SCUSTN);

  // Call selection program FRS405
  custNumber = 0;
  custName = SCUSTN;

  FRS405(custNumber : custName);

  // Update screen fields with selected values
  SCUST# = custNumber;
END-PROC;

//---------------------------------------------------------------------
// displayCommandLine - Display IBM i command line
//---------------------------------------------------------------------
DCL-PROC displayCommandLine;
  QUSCMDLN();
END-PROC;

//---------------------------------------------------------------------
// removeMessages - Remove program messages from message queue
//---------------------------------------------------------------------
DCL-PROC removeMessages;
  DCL-S rmvMsgQueue CHAR(10);
  DCL-S rmvCallStack INT(10);
  DCL-S rmvMsgKey CHAR(4);
  DCL-S rmvClearOpt CHAR(10);

  rmvMsgQueue = removeMsgDS.messageQueue;
  rmvCallStack = removeMsgDS.callStackCounter;
  rmvMsgKey = removeMsgDS.messageKey;
  rmvClearOpt = removeMsgDS.clearOption;

  QMHRMVPM(rmvMsgQueue : rmvCallStack : rmvMsgKey : rmvClearOpt : apiError);
END-PROC;

//---------------------------------------------------------------------
// sendMessage - Send program message to message queue
//---------------------------------------------------------------------
DCL-PROC sendMessage;
  DCL-S sndMsgFile CHAR(20);
  DCL-S sndMsgLen INT(10);
  DCL-S sndMsgType CHAR(10);
  DCL-S sndCallStack INT(10);
  DCL-S sndMsgKey CHAR(4);

  sndMsgFile = messageDS.messageFile;
  sndMsgLen = messageDS.messageLength;
  sndMsgType = messageDS.messageType;
  sndCallStack = messageDS.callStackCounter;
  sndMsgKey = messageDS.messageKey;

  QMHSNDPM(messageId : sndMsgFile : messageData : sndMsgLen :
           sndMsgType : messageQueue : sndCallStack : sndMsgKey : apiError);
END-PROC;
